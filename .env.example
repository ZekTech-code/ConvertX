# Firebase Project Configuration for Cross-Device Data Sync
# Copy this file to '.env' and fill in your details from the Firebase Console (Project Settings -> General -> Your Apps)

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# CoinMarketCap API — get free key at https://pro.coinmarketcap.com
# NOTE: In production, this key is proxied through Firebase Cloud Functions.
# Set it via: firebase functions:config:set coinmarketcap.key="YOUR_KEY"
# This variable is NOT prefixed with VITE_ so it is NOT embedded in client bundles.
CMC_API_KEY=YOUR_API_KEY_HERE

# Contact Info (used in the footer — not embedded in production builds)
VITE_CONTACT_EMAIL=your_email@example.com
VITE_CONTACT_WHATSAPP=your_whatsapp_number
VITE_CONTACT_PHONE=your_phone_number