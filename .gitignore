# SECURITY — Environment & Secrets
# Never commit real credentials, tokens, or private keys to version control.
# Use .env.example (with placeholder values only) as the committed template.

# Vite environment files
.env
.env.local
.env.production
.env.staging
.env.*.local
.env.development

# Generic secrets / credentials files
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets.json
secrets.*.json
credentials.json

# Firebase service account keys (downloaded from Firebase Console)
# These give FULL admin access — never commit them
service-account*.json
firebase-adminsdk*.json
*-firebase-adminsdk-*.json
serviceAccountKey.json

# Google Cloud credentials
application_default_credentials.json
gcloud-credentials.json

